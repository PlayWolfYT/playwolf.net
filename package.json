{
  "name": "playwolf.net",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.1",
  "//type": "Payload's CLI loads payload.config.ts through tsx, whose CommonJS loader cannot resolve extensionless TypeScript imports. ESM is also what Payload's own templates use. Next writes a `{\"type\":\"commonjs\"}` boundary into .next, so the standalone server is unaffected.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db garage && bun run garage:bootstrap",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "garage:bootstrap": "bun scripts/garage-bootstrap.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "graphql": "^16.11.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "motion": "^13.1.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.5",
    "ogl": "^1.0.11",
    "payload": "3.86.0",
    "react": "19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.10",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
