# Copy to `.env` for local dev, or set these in Coolify when deploying.

# --- App (Next.js) ---
# Maintenance mode is no longer an environment variable — toggle it under
# Site settings → Status in the admin, so it never needs a redeploy.

# Absolute site origin used for OpenGraph/Twitter image URLs so Discord/Telegram
# embed the full image. No trailing slash. Defaults to https://playwolf.net.
NEXT_PUBLIC_SITE_URL=https://playwolf.net

# --- Docker Compose — web ---
# Web container is built from `.` via Dockerfile (see docker-compose.yml).
# Host port only applies with docker-compose.host-ports.yml (local/debug).
# Coolify reaches the container on the Docker network; set the domain to
# http://playwolf.net:3000 so the proxy targets container port 3000.
WEB_PORT=3000

# --- Payload CMS ---
# Signs admin sessions and tokens. Changing it logs everyone out.
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-secret

# Authenticates the scheduled commission-reminder run:
#   curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://playwolf.net/api/cron/commission-reminders
# (`x-cron-secret: <value>` works too.) Unset or empty, that route answers 401 to
# everything and reminders silently never send, so docker-compose.yml guards it
# with `${CRON_SECRET:?}`. Compose interpolates the whole file regardless of which
# services you start, so leaving this blank also breaks `bun run dev:up`.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-secret

# Only needed when running Payload or Next outside compose (e.g. `bun run dev`);
# inside compose it is assembled from the POSTGRES_* values below.
DATABASE_URL=postgresql://playwolf:change-me@localhost:5432/playwolf

# --- Docker Compose — PostgreSQL (service hostname: `db`) ---
POSTGRES_USER=playwolf
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=playwolf
# Avoid raw @ : / ? # in POSTGRES_PASSWORD (breaks DATABASE_URL) or URL-encode them.

# --- Docker Compose — Garage object storage (service hostname: `garage`) ---
# Authenticates the node to itself and to any future peer. 32 random hex bytes:
# openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-to-32-random-hex-bytes

# Defaults match docker/garage.toml and the bucket the bootstrap creates.
S3_BUCKET=playwolf-media
S3_REGION=garage

# Local `bun run dev` (app on the host, Garage in Docker via docker-compose.dev.yml).
# Host publish is 7900→3900 (see docker-compose.dev.yml); inside compose use garage:3900.
#   S3_ENDPOINT=http://localhost:7900
# Inside compose (web container talking to the garage service):
#   S3_ENDPOINT=http://garage:3900  (set automatically in docker-compose.yml)
S3_ENDPOINT=http://localhost:7900

# --- S3 credentials ---
# Local development: use the pinned constants below. `bun run garage:bootstrap`
# (via `bun run dev:up`) imports them with `garage key import`. Garage requires
# Key ID = GK + 24 hex chars and Secret = 64 hex chars. These values are for
# localhost only — never reuse them outside local dev.
#
# Production / Coolify: leave blank here and paste the Key ID + Secret printed
# once by `garage key create playwolf-app` during the one-time bootstrap in
# docs/DEPLOYMENT.md section 7. The secret is not shown again.
S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeef
S3_SECRET_ACCESS_KEY=beefcafebeefcafebeefcafebeefcafebeefcafebeefcafebeefcafebeefcafe

# --- Analytics (optional, service hostname: `umami`) ---
# Umami starts with the rest of the stack. Leave the two UMAMI_*_URL/ID values
# empty and the site renders no tracker.

# Where the browser fetches the tracker from, and which site it reports as.
# The ID is printed by Umami's dashboard after you add the website.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Signs Umami's own sessions. openssl rand -hex 32
# Also `${...:?}`-guarded in docker-compose.yml, so it cannot be left blank here.
UMAMI_APP_SECRET=change-me-to-a-long-random-secret
# Database created inside the existing Postgres instance.
UMAMI_DB=umami
# Host port only with docker-compose.host-ports.yml. On Coolify use
# http://umami.playwolf.net:3000 (container port in the domain field).
UMAMI_PORT=3001
