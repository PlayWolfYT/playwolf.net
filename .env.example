# Copy to `.env` for local dev, or set these in Portainer when using docker compose.

# --- App (Next.js) ---
# true / 1 / yes = maintenance page; anything else = early-access placeholder
MAINTENANCE_MODE=false

# --- Docker Compose — web ---
WEB_PORT=3000
# Web container is built from `.` via Dockerfile (see docker-compose.yml).

# --- Docker Compose — PostgreSQL (service hostname: `db`) ---
POSTGRES_USER=playwolf
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
POSTGRES_DB=playwolf
# Avoid raw @ : / ? # in POSTGRES_PASSWORD (breaks DATABASE_URL) or URL-encode them.

# REDIS_URL is set inside compose for Redis; no env needed unless you customize Redis.
